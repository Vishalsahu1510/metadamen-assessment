# Server Configuration
PORT=5000
NODE_ENV=development

# AI Provider Configuration
# Supported providers: "gemini" | "groq" | "mock"
AI_PROVIDER=gemini

# Google Gemini API Key (Get a 100% free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq Cloud API Key (Optional free alternative at: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Semantic Duplicate Threshold (0.0 to 1.0)
# >= 0.85 considered exact or semantic duplicate
# 0.55 - 0.84 considered related domain, distinct question
# < 0.55 distinct topic
DUPLICATE_SIMILARITY_THRESHOLD=0.82

# Database Configuration (Neon Serverless PostgreSQL)
# Get a 100% free serverless database at: https://neon.tech
# Leave empty to use automatic local JSON fallback
DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
